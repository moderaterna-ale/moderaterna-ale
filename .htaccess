RewriteEngine On

# Block sensitive files
<FilesMatch "^\.env|package\.json|package-lock\.json|\.db$">
    Require all denied
</FilesMatch>

# Allow direct access to uploads in /wp/wp-content/uploads/
RewriteCond %{REQUEST_URI} !^/wp/wp-content/uploads/ [NC]

# Redirect legacy WordPress requests (/wp, /wp-admin, old posts) to root
RewriteRule ^wp(/.*)?$ / [R=301,L]

# API routes -> api.php
RewriteRule ^api/quiz/(.*)$ api.php?route=$1 [QSA,L]
RewriteRule ^api/(.*)$ api.php?route=$1 [QSA,L]

# Clean URLs for Quiz and Admin
RewriteRule ^quiz/?$ quiz.html [L]
RewriteRule ^quiz-admin/?$ quiz-admin.html [L]

# Ensure index.html is the default document
DirectoryIndex index.html

# UTF-8 Encoding
AddDefaultCharset UTF-8
